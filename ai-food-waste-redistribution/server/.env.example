NODE_ENV=development
PORT=5000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=food_waste_redistribution
DB_USER=root
DB_PASSWORD=

# Auth
JWT_SECRET=change-me-in-local-env
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

# AI microservice
AI_SERVICE_URL=http://localhost:8000

# Media storage (Cloudinary — leave blank to fall back to local disk storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Maps
GOOGLE_MAPS_API_KEY=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
